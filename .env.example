# Local-development defaults only. Copy to .env. Nothing here is a real secret.
POSTGRES_USER=coldchain
POSTGRES_PASSWORD=coldchain_dev
POSTGRES_DB=coldchain

# Service authentication. Empty = no auth (fine on a laptop). Set one random value to require it on
# core, ml-api and the monitor (/v1/*), and set DASHBOARD_PASSWORD to put the dashboard behind a password.
# A shared key is not per-user auth; put TLS in front of anything reachable beyond localhost.
API_KEY=
DASHBOARD_PASSWORD=
# Delete readings older than this many days before the newest one (0 = keep everything; minimum 3).
RETENTION_DAYS=0
# Optional: POST alert events (opened/closed) to a chat or incident webhook.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=

# Optional: move host ports that are already taken on your machine (defaults shown).
# ML_API_PORT=8080
# DASHBOARD_PORT=3000
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3001
